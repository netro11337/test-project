# Ozon Auto-Registration Environment Variables
# Переменные окружения для системы автоматической регистрации Ozon

# ===== OZON API =====
# Ozon API Key - получить можно в личном кабинете Ozon
OZON_API_KEY=your_api_key_here

# Ozon Client ID для OAuth
OZON_CLIENT_ID=your_client_id_here

# ===== SMS SERVICE =====
# SMS сервис для получения кодов подтверждения
# Примеры: SMS-Perfect, Twilio, Smspilot и т.д.

# URL SMS сервиса API
SMS_SERVICE_URL=https://api.sms-service.com/api

# API ключ SMS сервиса
SMS_API_KEY=your_sms_api_key_here

# ===== DATABASE =====
# Database credentials (if using PostgreSQL)
DB_USER=postgres
DB_PASSWORD=your_password_here

# ===== LOGGING =====
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Debug mode
DEBUG=false

# ===== PVZ LIST =====
# ID пунктов выдачи (ПВЗ) - используйте реальные ID из Ozon
# Формат: PVZ_ID1,PVZ_ID2,PVZ_ID3
PVZ_LIST=00000000000000000001,00000000000000000002,00000000000000000003
